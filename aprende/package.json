{
  "name": "aprende",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:web": "vite build --mode web",
    "build:ext": "vite build --mode extension",
    "dev": "vite",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:types": "node scripts/i18n-check.mjs --write",
    "test:e2e": "playwright test",
    "pack:ext": "npm run build:ext && node scripts/pack-extension.mjs"
  },
  "dependencies": {
    "@fontsource/league-spartan": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@preact/signals": "^2.0.4",
    "preact": "^10.25.4",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.9.3",
    "@testing-library/preact": "^3.2.4",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.5",
    "@types/three": "^0.160.0",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "lighthouse": "^12.8.2",
    "puppeteer-core": "^22.15.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "web-vitals": "^4.2.4"
  }
