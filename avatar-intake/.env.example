# Voice and transcription run free on this PC by default (Kokoro + Whisper). Optional overrides:
# LOCAL_VOICE_ES=piper:es_MX-ald-medium   LOCAL_VOICE_EN=kokoro:am_adam   WHISPER_MODEL=small   WHISPER_DEVICE=cpu
# To use ElevenLabs instead: VOICE_ENGINE=elevenlabs and a key (elevenlabs.io -> Profile -> API keys)
ELEVENLABS_API_KEY=
# Optional: any male voice id from the ElevenLabs voice library (default: Brian)
# ELEVENLABS_VOICE_ID=
# Model behind the free conversation (?chat=1), the attorney memo and the draft will. Set ONE of these.
# Reflection AI's Beam (used when set; same API and model as the Carbon Law backend). Optional: REFLECTION_MODEL=
REFLECTION_API_KEY=
# Or Anthropic's Claude. Optional: ANTHROPIC_MODEL=claude-sonnet-5-5, ANTHROPIC_DRAFT_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
